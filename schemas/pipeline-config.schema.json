{
  "$defs": {
    "MethodSpec": {
      "additionalProperties": false,
      "description": "Name and config payload for a registered method.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "MethodSpec",
      "type": "object"
    },
    "ModelLoadConfig": {
      "additionalProperties": false,
      "description": "Configuration for model wrapper construction.",
      "properties": {
        "cache_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Dir"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "dtype": {
          "default": "float32",
          "title": "Dtype",
          "type": "string"
        },
        "load_kwargs": {
          "additionalProperties": true,
          "title": "Load Kwargs",
          "type": "object"
        },
        "local_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Dir"
        },
        "modelscope_kwargs": {
          "additionalProperties": true,
          "title": "Modelscope Kwargs",
          "type": "object"
        },
        "name": {
          "default": "dummy",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "source": {
          "default": "huggingface",
          "description": "Model backend selector.",
          "enum": [
            "dummy",
            "mock",
            "none",
            "huggingface",
            "hf",
            "local",
            "qwen3",
            "qwen3_dense",
            "qwen3-dense",
            "modelscope",
            "ms"
          ],
          "title": "Source",
          "type": "string"
        },
        "tokenizer_kwargs": {
          "additionalProperties": true,
          "title": "Tokenizer Kwargs",
          "type": "object"
        },
        "trust_remote_code": {
          "default": false,
          "title": "Trust Remote Code",
          "type": "boolean"
        }
      },
      "title": "ModelLoadConfig",
      "type": "object"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "description": "Output configuration for generated reports.",
      "properties": {
        "report_path": {
          "default": "./safety_scan.json",
          "title": "Report Path",
          "type": "string"
        }
      },
      "title": "OutputConfig",
      "type": "object"
    },
    "PipelineSectionConfig": {
      "additionalProperties": false,
      "description": "Registered methods and runner behavior.",
      "properties": {
        "attributors": {
          "items": {
            "$ref": "#/$defs/MethodSpec"
          },
          "title": "Attributors",
          "type": "array"
        },
        "monitors": {
          "items": {
            "$ref": "#/$defs/MethodSpec"
          },
          "title": "Monitors",
          "type": "array"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/MethodSpec"
          },
          "title": "Probes",
          "type": "array"
        },
        "risk_threshold": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Threshold",
          "type": "number"
        }
      },
      "title": "PipelineSectionConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top-level YAML config for `safelens run`.",
  "properties": {
    "dataset": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Dataset",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelLoadConfig"
    },
    "output": {
      "$ref": "#/$defs/OutputConfig"
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineSectionConfig"
    }
  },
  "title": "PipelineConfig",
  "type": "object"
}
